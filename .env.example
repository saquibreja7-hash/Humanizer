# --- HIP engine (Cerebellum Cloud, raw /v1/completions) ---
CEREBELLUM_API_KEY=cb_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HIP_BACKEND_URL=https://api.cerebellumlabs.ai
HIP_BACKEND_MODE=openai
HIP_MODEL_NAME=jamsaq-v1
HIP_WORKERS=6

# --- App ---
APP_URL=http://localhost:3000
SESSION_SECRET=generate_with__openssl_rand_hex_32
DATABASE_PATH=proseflow.db

# --- Billing ---
# When live billing keys are unset, set to true to use the local checkout simulator.
DEV_BILLING_SIMULATOR=true

# Dodo Payments (global Merchant of Record). Create products in the Dodo dashboard
# and paste their IDs here, one per plan.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID_STARTER=
DODO_PRODUCT_ID_PRO=
DODO_PRODUCT_ID_BUSINESS=

# Razorpay (India: UPI/cards). Amounts are INR.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
